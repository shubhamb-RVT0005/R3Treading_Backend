    private boolean sendEmailOtp(String email, String otpCode) {

        String subject = "R3Treading Email Verification OTP";

        String message = "Your R3Treading OTP is "
                + otpCode
                + ". This OTP is valid for 1 minute.";

        try {

            OtpResponse response = notificationServiceClient.sendEmail(
                    email,
                    subject,
                    message
            );

            return response != null && response.isSuccess();

        } catch (Exception e) {

            e.printStackTrace();

            return false;
        }
